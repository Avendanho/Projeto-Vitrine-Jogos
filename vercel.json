{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"O build do PokéAtlas não usa dependências\"",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/biblioteca/", "destination": "/pokedex/", "permanent": false },
    { "source": "/cobblemon/guia/", "destination": "/cobblemon/biomas/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(fontes|arte|maquetes)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
