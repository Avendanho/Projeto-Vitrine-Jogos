{
  "name": "pokeatlas",
  "version": "1.0.0",
  "private": true,
  "description": "PokéAtlas — guia visual para descobrir qual jogo de Pokémon combina com você. Projeto de fã, não oficial.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/servir.mjs",
    "arte": "node scripts/arte.mjs",
    "arte:mini": "node scripts/arte.mjs --mini",
    "arte:formas": "node scripts/arte.mjs --formas",
    "arte:pixel": "node scripts/arte.mjs --pixel",
    "cobblemon": "node scripts/cobblemon.mjs",
    "modelos": "node scripts/modelos.mjs",
    "itens": "node scripts/itens-arte.mjs",
    "maquetes": "node scripts/maquetes.mjs",
    "pokedex": "node scripts/pokedex.mjs && node scripts/fichas.mjs",
    "cartas": "node scripts/cartas.mjs",
    "verificar": "node scripts/verificar-paginas.mjs",
    "mod": "node scripts/baixar-mod.mjs",
    "test": "node --test testes/*.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.50.0",
    "sharp": "^0.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
